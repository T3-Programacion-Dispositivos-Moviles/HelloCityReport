<?xml version="1.0" encoding="utf-8"?>
<!-- Foto de la incidencia en pantalla completa (destino de la transición desde el detalle).
     El fondo negro es una vista aparte para que solo él se desvanezca y la foto se anime sola. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/vFondoFoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000" />

    <ImageView
        android:id="@+id/ivFotoCompleta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/descripcion_foto_incidencia"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/btnCerrarFoto"
        style="@style/Widget.CityReport.BotonCamara"
        android:layout_margin="12dp"
        android:contentDescription="@string/descripcion_cerrar"
        android:src="@drawable/ic_cerrar" />

</FrameLayout>
