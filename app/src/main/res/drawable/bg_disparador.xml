<?xml version="1.0" encoding="utf-8"?>
<!-- Botón disparador de la cámara: aro blanco con círculo al centro. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#80FFFFFF" /></shape></item>
            <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp"><shape android:shape="oval"><solid android:color="#80FFFFFF" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFFFF" /></shape></item>
            <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp"><shape android:shape="oval"><solid android:color="#FFDDDDDD" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFFFF" /></shape></item>
            <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp"><shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape></item>
        </layer-list>
    </item>
</selector>
