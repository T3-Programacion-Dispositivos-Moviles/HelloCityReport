<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Chip que solo informa el estado (no se puede tocar). Los colores se ponen en
         código con ChipEstado.kt para que salgan del tema y cambien con los colores dinámicos. -->
    <style name="Widget.CityReport.ChipEstado" parent="Widget.Material3.Chip.Assist">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- Esquinas redondeadas de las fotos (ShapeableImageView). -->
    <style name="ShapeAppearance.CityReport.Redondeada" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Botones redondos sobre la vista previa de la cámara y el visor de fotos. -->
    <style name="Widget.CityReport.BotonCamara" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_boton_camara</item>
        <item name="android:scaleType">center</item>
        <item name="tint">#FFFFFFFF</item>
    </style>

    <!-- Etiqueta pequeña sobre cada dato (pantalla de detalle). -->
    <style name="TextAppearance.CityReport.Etiqueta" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
